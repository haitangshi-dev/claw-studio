/* Claw Agent — 灰底 · 紫青双色点缀 · 终端锚点 */

:root {
  --bg: #181818;
  --bg-soft: #1F1F1F;
  --bg-soft2: #2A2A2A;
  --bg-panel: #212121;
  --border: #2E2E2E;
  --border-strong: #3E3E3E;
  --text: #ECECEC;
  --text-dim: #A2A2A2;
  --text-faint: #6F6F6F;
  /* 双色系统：紫（主）+ 青（辅） */
  --violet: #8B7CF6;
  --violet-2: #9B8CFF;
  --cyan: #2BC8E0;
  --violet-grad: linear-gradient(135deg, #9B8CFF, #7C6AF0);
  --violet-soft: rgba(139, 124, 246, 0.16);
  --violet-border: rgba(139, 124, 246, 0.45);
  --cyan-border: rgba(43, 200, 224, 0.35);
  --cyan-soft: rgba(43, 200, 224, 0.12);
  /* 历史变量名映射到双色系统 */
  --gold: var(--violet);
  --gold-dim: var(--violet-soft);
  --gold-border: var(--violet-border);
  --gold-grad: var(--violet-grad);
  --accent: #2BC8E0;
  --term-bg: #0D0D0D;
  --term-text: #E0E0E0;
  --ok: #2EB67D;
  --err: #E5484D;
  --mono: Consolas, "JetBrains Mono", "Courier New", monospace;
  --radius: 14px;
  --radius-sm: 10px;
  --ease: 170ms cubic-bezier(0.4, 0, 0.2, 1);
  --inset-hi: inset 0 1px 0 rgba(255, 255, 255, 0.055);
  --shadow-sm: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 1px 3px rgba(0, 0, 0, 0.35);
  --shadow-md: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 6px 20px rgba(0, 0, 0, 0.45);
  --shadow-lg: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 18px 52px rgba(0, 0, 0, 0.6);
}

* { box-sizing: border-box; }

html, body, #root { height: 100%; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", system-ui, sans-serif;
  font-size: 14.5px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

.app { display: flex; height: 100vh; overflow: hidden; }

::selection { background: rgba(255, 255, 255, 0.18); }

::-webkit-scrollbar { width: 9px; height: 9px; }
::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  border: 2.5px solid transparent;
  background-clip: content-box;
}
::-webkit-scrollbar-thumb:hover { background-color: rgba(255, 255, 255, 0.22); background-clip: content-box; border: 2.5px solid transparent; }
::-webkit-scrollbar-track { background: transparent; }

/* ---------- 侧栏 ---------- */
.sidebar {
  width: 250px;
  flex-shrink: 0;
  background: var(--bg-panel);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}

.sidebar .brand {
  padding: 20px 18px 14px;
  font-size: 13px;
  letter-spacing: 0.16em;
  color: var(--text);
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10px;
}
.sidebar .brand .logo-glow { display: flex; }

.newchat-btn {
  margin: 4px 12px 12px;
  padding: 10px 14px;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--violet-grad);
  color: #FFFFFF;
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 9px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 4px 16px rgba(124, 106, 240, 0.25);
  transition: transform var(--ease), box-shadow var(--ease), filter var(--ease);
}
.newchat-btn:hover {
  transform: translateY(-1px);
  filter: brightness(1.08);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 6px 22px rgba(124, 106, 240, 0.35);
}
.newchat-btn:active { transform: none; }

/* 搜索框 */
.session-search-wrap {
  margin: 0 12px 8px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 11px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--bg);
  color: var(--text-faint);
  transition: border-color var(--ease), color var(--ease);
}
.session-search-wrap:focus-within { border-color: var(--violet-border); color: var(--text-dim); }
.session-search {
  flex: 1;
  min-width: 0;
  border: none;
  background: transparent;
  outline: none;
  color: var(--text);
  font-size: 12.5px;
  font-family: inherit;
}
.session-search::placeholder { color: var(--text-faint); }

.session-list { flex: 1; overflow-y: auto; padding: 4px 8px; }
.session-empty-hint { padding: 16px 12px; font-size: 12px; color: var(--text-faint); text-align: center; }
.session-group-title {
  font-size: 10.5px;
  letter-spacing: 0.16em;
  color: var(--text-faint);
  padding: 10px 12px 6px;
  font-weight: 600;
  user-select: none;
}

.session-item {
  position: relative;
  padding: 9px 12px;
  border-radius: 8px;
  font-size: 13px;
  color: var(--text-dim);
  cursor: pointer;
  transition: background var(--ease), color var(--ease);
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 2px;
  overflow: hidden;
}
.session-item:hover { background: var(--bg-soft2); color: var(--text); }
.session-item.active {
  background: linear-gradient(90deg, var(--violet-soft), rgba(139, 124, 246, 0.04));
  color: var(--text);
  font-weight: 500;
  box-shadow: inset 2px 0 0 var(--violet);
}
.session-item.active .s-title { color: var(--violet-2); }
.session-item .s-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.session-item.empty .si-preview { color: var(--text-faint); }

/* 两行信息：标题+时间 / 消息预览 */
.si-top { display: flex; align-items: center; gap: 8px; }
.si-icon {
  width: 24px;
  height: 24px;
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid transparent;
}
.si-time { font-size: 10.5px; color: var(--text-faint); font-family: var(--mono); flex-shrink: 0; }
.si-preview {
  font-size: 11.5px;
  color: var(--text-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  opacity: 0.85;
}
.session-item:hover .si-time { visibility: hidden; }

/* hover 操作（重命名 / 删除），悬浮右上 */
.s-actions { position: absolute; top: 7px; right: 8px; display: flex; gap: 2px; opacity: 0; flex-shrink: 0; transition: opacity var(--ease); }
.session-item:hover .s-actions { opacity: 1; }

/* 侧栏折叠 */
.app.side-collapsed .sidebar { display: none; }
.s-actions button {
  width: 22px;
  height: 22px;
  border: none;
  background: transparent;
  color: var(--text-faint);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background var(--ease), color var(--ease);
}
.s-actions button:hover { background: rgba(255, 255, 255, 0.09); color: var(--text); }
.s-actions button:last-child:hover { background: rgba(229, 72, 77, 0.16); color: var(--err); }

/* 就地重命名 */
.session-rename {
  flex: 1;
  min-width: 0;
  background: var(--bg);
  border: 1px solid var(--border-strong);
  border-radius: 6px;
  padding: 3px 8px;
  color: var(--text);
  font-size: 13px;
  font-family: inherit;
  outline: none;
}

.sidebar .footer {
  border-top: 1px solid var(--border);
  padding: 9px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.footer-btn {
  padding: 9px 12px;
  border: none;
  background: transparent;
  color: var(--text-dim);
  font-size: 13px;
  cursor: pointer;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 9px;
  transition: background var(--ease), color var(--ease);
}
.footer-btn:hover { background: var(--bg-soft2); color: var(--violet-2); }

/* ---------- 主区 ---------- */
.main { flex: 1; display: flex; flex-direction: column; min-width: 0; background: var(--bg); }

.header {
  height: 58px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 20px;
  border-bottom: 1px solid var(--border);
  background: var(--bg);
}

/* 模型选择器 */
.model-select { position: relative; }
.model-select .ms-trigger {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 7px 12px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: border-color var(--ease), background var(--ease);
  max-width: 270px;
}
.model-select .ms-trigger:hover { border-color: #575757; background: var(--bg-soft2); }
.model-select .ms-trigger .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-select .ms-trigger .chev { color: var(--text-faint); display: flex; }

.model-menu {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  min-width: 380px;
  background: var(--bg-panel);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  z-index: 60;
  padding: 6px;
  max-height: 400px;
  overflow-y: auto;
  animation: pop 140ms cubic-bezier(0.2, 0.9, 0.3, 1.15);
}
@keyframes pop { from { opacity: 0; transform: translateY(-6px) scale(0.985); } to { opacity: 1; transform: none; } }

.model-item {
  padding: 9px 11px;
  border-radius: 8px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 2px;
  transition: background var(--ease);
  user-select: none;
}
.model-item:hover { background: var(--bg-soft2); }
.model-item.current { background: var(--violet-soft); box-shadow: inset 2px 0 0 var(--violet); }
.model-item .mi-name { font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 8px; }
.model-item .mi-meta { font-size: 11.5px; color: var(--text-faint); font-family: var(--mono); }
.tag-pill {
  font-size: 10.5px;
  padding: 1px 8px;
  border-radius: 20px;
  border: 1px solid var(--border-strong);
  color: var(--text-dim);
  background: var(--bg-soft);
  letter-spacing: 0.03em;
  font-weight: 400;
}

/* 思考强度：模型项内右键展开 */
.think-row {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 8px 10px 6px;
  margin-top: 6px;
  border-top: 1px dashed var(--border-strong);
  flex-wrap: wrap;
  cursor: default;
}
.think-row .think-lab { font-size: 11px; color: var(--text-faint); margin-right: 4px; letter-spacing: 0.06em; }
.think-opt {
  border: 1px solid var(--border-strong);
  background: transparent;
  color: var(--text-dim);
  font-size: 11.5px;
  padding: 3px 11px;
  border-radius: 20px;
  cursor: pointer;
  transition: background var(--ease), color var(--ease), border-color var(--ease);
  font-family: inherit;
}
.think-opt:hover { background: var(--bg-soft2); color: var(--text); }
.think-opt.on { background: var(--violet-grad); color: #FFFFFF; border-color: var(--violet); font-weight: 600; }
.model-item .mi-think { color: var(--text-faint); font-size: 11px; margin-left: auto; padding-left: 8px; white-space: nowrap; }
.model-menu-hint {
  padding: 8px 12px 6px;
  margin-top: 4px;
  border-top: 1px solid var(--border);
  font-size: 11px;
  color: var(--text-faint);
  user-select: none;
  cursor: default;
}

.header .chat-title {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--text);
  max-width: 42%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.header .ctx-meter {
  font-size: 11.5px;
  font-family: var(--mono);
  color: var(--text-faint);
  padding: 5px 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--bg-soft);
  white-space: nowrap;
}
.header .ctx-meter.warn { color: #D8A657; border-color: rgba(216, 166, 87, 0.35); }
.header .ctx-meter.red { color: var(--err); border-color: rgba(229, 72, 77, 0.4); }
.header .ctx-compress {
  font-size: 11.5px;
  font-family: var(--mono);
  color: var(--violet-2);
  padding: 5px 12px;
  border: 1px solid var(--violet-border);
  border-radius: 8px;
  background: var(--violet-soft);
  cursor: pointer;
  transition: all 0.15s;
}
.header .ctx-compress:hover:not(:disabled) { background: rgba(139, 124, 246, 0.28); }
.header .ctx-compress:disabled { opacity: 0.45; cursor: default; }
.header .spacer { flex: 1; }
.header .workdir {
  font-family: var(--mono);
  font-size: 11.5px;
  color: var(--text-dim);
  max-width: 300px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 5px 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--bg-soft);
}
.dot-status { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.dot-status.on { background: var(--ok); }
.dot-status.off { background: #555555; }
.dot-status.busy { background: var(--cyan); box-shadow: 0 0 8px rgba(43, 200, 224, 0.6); animation: breath 1.2s ease-in-out infinite; }
@keyframes breath { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.8); } }

/* ---------- 消息流 ---------- */
.messages { flex: 1; overflow-y: auto; padding: 28px 0 10px; }
.msg-col { max-width: 860px; margin: 0 auto; padding: 0 28px; display: flex; flex-direction: column; gap: 26px; }

.msg-user { display: flex; justify-content: flex-end; }
.msg-user .bubble {
  max-width: 76%;
  background: linear-gradient(135deg, #262339 0%, #1F1D2E 100%);
  border: 1px solid rgba(139, 124, 246, 0.22);
  padding: 11px 15px;
  border-radius: 16px 16px 5px 16px;
  white-space: pre-wrap;
  word-break: break-word;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
}
.msg-user .bubble-edit { max-width: 82%; padding: 10px 12px 7px; }
.bubble-edit textarea {
  width: 100%;
  min-width: 340px;
  background: transparent;
  border: none;
  outline: none;
  resize: vertical;
  color: var(--text);
  font-family: inherit;
  font-size: 14px;
  line-height: 1.6;
}
.bubble-edit-hint { font-size: 10.5px; color: var(--text-faint); margin-top: 4px; text-align: right; }

.msg-assistant { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 14px; align-items: start; }
.msg-assistant .avatar {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--violet-grad);
  margin-top: 2px;
  box-shadow: 0 2px 12px rgba(124, 106, 240, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.22);
}
.msg-assistant .body { display: flex; flex-direction: column; gap: 12px; min-width: 0; }

/* 思考折叠区 */
.reasoning {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  overflow: hidden;
}
.reasoning .r-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 13px;
  cursor: pointer;
  font-size: 12.5px;
  color: var(--text-faint);
  user-select: none;
  transition: color var(--ease), background var(--ease);
}
.reasoning .r-head:hover { color: var(--text-dim); background: var(--bg-soft2); }
.reasoning .r-head .chev { transition: transform var(--ease); display: flex; }
.reasoning.open .r-head .chev { transform: rotate(90deg); }
.reasoning .r-body {
  padding: 10px 15px 13px;
  color: var(--text-dim);
  font-size: 13px;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 300px;
  overflow-y: auto;
  border-top: 1px solid var(--border);
}
.reasoning.streaming .r-head { color: var(--text-dim); }
.reasoning.streaming .r-head::after {
  content: "";
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--cyan);
  margin-left: 2px;
  animation: breath 1.2s ease-in-out infinite;
}

/* 工具卡片（白卡 + 更深终端） */
.toolcard {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
  overflow: hidden;
  font-family: var(--mono);
  box-shadow: var(--shadow-sm);
  transition: border-color var(--ease), box-shadow var(--ease);
}
.toolcard:hover { border-color: var(--cyan-border); box-shadow: var(--shadow-md); }
.toolcard .t-head {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 9px 13px;
  font-size: 12.5px;
  cursor: pointer;
  user-select: none;
  transition: background var(--ease);
}
.toolcard .t-head:hover { background: var(--bg-soft2); }
.toolcard .t-name { color: var(--text); font-weight: 600; letter-spacing: 0.01em; }
.toolcard .t-args {
  color: var(--text-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  font-size: 12px;
}
.toolcard .t-time { color: var(--text-faint); font-size: 11.5px; }
.toolcard .t-body {
  padding: 12px 14px;
  font-size: 12px;
  color: var(--term-text);
  white-space: pre-wrap;
  word-break: break-all;
  max-height: 340px;
  overflow-y: auto;
  background: var(--term-bg);
  line-height: 1.6;
}
.toolcard.fail { border-color: rgba(229, 72, 77, 0.5); }

/* 正文 */
.content-body { word-break: break-word; }
.content-body p { margin: 0 0 10px; }
.content-body p:last-child { margin-bottom: 0; }
.content-body h1, .content-body h2, .content-body h3 { margin: 16px 0 8px; font-weight: 650; line-height: 1.35; }
.content-body h1 { font-size: 20px; }
.content-body h2 { font-size: 17px; }
.content-body h3 { font-size: 15px; }
.content-body ul, .content-body ol { margin: 4px 0 10px; padding-left: 22px; }
.content-body li { margin: 2.5px 0; }
.content-body li::marker { color: var(--text-faint); }
.content-body code {
  font-family: var(--mono);
  font-size: 12.5px;
  background: var(--bg-soft2);
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 1px 6px;
  color: #DCDCDC;
}
.content-body pre {
  background: #141414;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  overflow-x: auto;
  margin: 9px 0;
}
.content-body pre code { background: transparent; border: none; padding: 0; font-size: 12.5px; line-height: 1.6; color: #CFCFCF; }
.content-body a { color: var(--accent); text-decoration: none; }
.content-body a:hover { text-decoration: underline; }
.content-body strong { color: #FFFFFF; }
.content-body.compressed {
  border: 1px dashed var(--border-strong);
  background: var(--bg-soft);
  border-radius: var(--radius-sm);
  padding: 12px 15px;
  color: var(--text-dim);
}

/* 上下文压缩分隔卡（界面保留全部记录，此卡标记压缩边界） */
.compacted-divider {
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 9px 14px;
  font-size: 12px;
  color: var(--text-faint);
  background: var(--bg-soft);
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.compacted-divider summary { cursor: pointer; color: var(--text-dim); user-select: none; }
.compacted-divider summary:hover { color: var(--text); }
.compacted-divider .cd-body {
  margin-top: 7px;
  color: var(--text-dim);
  font-size: 12.5px;
  white-space: pre-wrap;
  line-height: 1.65;
}

/* 自动恢复提示行（如工具参数截断后转分块重试） */
.notice-line {
  border-left: 2px solid var(--violet-border);
  background: var(--bg-soft);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  padding: 5px 12px;
  font-size: 12px;
  color: var(--text-dim);
  font-family: var(--mono);
}

.caret {
  display: inline-block;
  width: 7px;
  height: 15px;
  background: var(--cyan);
  vertical-align: -2px;
  margin-left: 2px;
  animation: blink 1s steps(2) infinite;
  border-radius: 2px;
}
@keyframes blink { 50% { opacity: 0; } }

.msg-meta { font-size: 11.5px; color: var(--text-faint); font-family: var(--mono); display: flex; gap: 14px; align-items: center; }
.msg-actions { margin-left: auto; display: flex; gap: 4px; }
.icon-btn.mini {
  width: 26px;
  height: 26px;
  border-radius: 7px;
  background: transparent;
  color: var(--text-faint);
}
.icon-btn.mini:hover { background: var(--bg-soft2); color: var(--text); }

/* 回到底部（浮动） */
.jump-bottom {
  position: fixed;
  right: 42px;
  bottom: 168px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid var(--border-strong);
  background: var(--bg-panel);
  color: var(--text-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: var(--shadow-md);
  z-index: 50;
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px);
  transition: opacity 0.2s ease, transform 0.2s ease, color var(--ease), border-color var(--ease);
}
.jump-bottom.show { opacity: 1; pointer-events: auto; transform: none; }
.jump-bottom:hover { color: var(--text); border-color: #575757; }

/* ---------- 欢迎屏 ---------- */
.welcome {
  min-height: 66vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  user-select: none;
  padding: 30px 0 10px;
}
.welcome .w-logo {
  margin-bottom: 24px;
  filter: drop-shadow(0 0 28px rgba(139, 124, 246, 0.35)) drop-shadow(0 0 70px rgba(43, 200, 224, 0.14));
  animation: rise 0.55s ease backwards;
}
.welcome .w-title {
  font-size: 52px;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.12;
  background: linear-gradient(118deg, #E8E4FF 20%, #9B8CFF 55%, #2BC8E0 90%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: rise 0.55s 0.06s ease backwards;
}
.welcome .w-sub {
  font-size: 13px;
  color: var(--text-faint);
  font-family: var(--mono);
  margin-top: 14px;
  letter-spacing: 0.05em;
  animation: rise 0.55s 0.12s ease backwards;
}
/* 首屏实时状态条：把「当前拿什么在跑」摆在眼前（紫青点缀保留） */
.welcome .w-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0;
  margin-top: 30px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg-soft);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  animation: rise 0.55s 0.17s ease backwards;
}
.welcome .w-stat {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 11px 18px;
  min-width: 104px;
  border-right: 1px solid var(--border);
}
.welcome .w-stat:last-child { border-right: none; }
.welcome .w-stat-k {
  font-size: 10.5px;
  color: var(--text-faint);
  font-family: var(--mono);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.welcome .w-stat-v {
  font-size: 13px;
  color: var(--text);
  font-family: var(--mono);
  max-width: 190px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.welcome .w-stat-v.dim { color: var(--text-dim); }
.welcome .w-stat-v.hot { color: var(--violet-2); }
.welcome .w-stat-v.warn { color: #D8A657; }
.welcome .w-stat-v.err { color: var(--err); }
.welcome .w-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 34px;
  animation: rise 0.55s 0.2s ease backwards;
  width: 100%;
  max-width: 620px;
}
@media (max-width: 720px) {
  .welcome .w-cards { grid-template-columns: 1fr; }
  .welcome .w-title { font-size: 40px; }
}
.welcome .w-card {
  text-align: left;
  padding: 15px 17px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg-soft);
  color: var(--text-dim);
  font-size: 12.5px;
  line-height: 1.55;
  font-family: inherit;
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  transition: transform var(--ease), border-color var(--ease), box-shadow var(--ease), background var(--ease);
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.welcome .w-card .w-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.welcome .w-card .w-card-tag {
  font-size: 10px;
  font-family: var(--mono);
  color: var(--cyan);
  border: 1px solid var(--cyan-border);
  background: var(--cyan-soft);
  border-radius: 5px;
  padding: 1px 6px;
  flex-shrink: 0;
}
.welcome .w-card .w-card-d { color: var(--text-dim); }
.welcome .w-card .w-card-t {
  font-size: 14px;
  color: var(--text);
  font-weight: 650;
  display: flex;
  align-items: center;
  gap: 9px;
}
.welcome .w-card .w-card-t svg { color: var(--cyan); }
.welcome .w-card:hover {
  transform: translateY(-3px);
  border-color: var(--violet-border);
  background: linear-gradient(180deg, var(--violet-soft), rgba(255, 255, 255, 0.025));
  box-shadow: var(--shadow-lg), 0 0 30px rgba(139, 124, 246, 0.1);
}
.welcome .w-card:hover .w-card-t svg { color: var(--violet-2); }
@keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

/* ---------- 状态栏（模型在干什么） ---------- */
.status-bar {
  max-width: 860px;
  margin: 0 auto 8px;
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 20px;
  font-size: 12px;
  color: var(--text-faint);
  user-select: none;
}
.status-bar .sb-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4E4E4E;
  flex-shrink: 0;
  transition: background var(--ease);
}
.status-bar .sb-icon { display: flex; color: var(--violet-2); }
.status-bar .sb-label { letter-spacing: 0.02em; }

.status-bar.preparing .sb-dot,
.status-bar.writing .sb-dot,
.status-bar.thinking .sb-dot {
  background: var(--cyan);
  box-shadow: 0 0 8px rgba(43, 200, 224, 0.55);
  animation: breath 1.2s ease-in-out infinite;
}
.status-bar.tool .sb-dot {
  background: var(--violet);
  box-shadow: 0 0 8px rgba(139, 124, 246, 0.6);
  animation: breath 1.2s ease-in-out infinite;
}
.status-bar.compressing .sb-dot {
  background: #D8A657;
  box-shadow: 0 0 8px rgba(216, 166, 87, 0.55);
  animation: breath 1.2s ease-in-out infinite;
}
.status-bar.error .sb-dot { background: var(--err); }
.status-bar.preparing .sb-label,
.status-bar.writing .sb-label,
.status-bar.thinking .sb-label,
.status-bar.tool .sb-label,
.status-bar.compressing .sb-label { color: var(--text-dim); }
.status-bar.error .sb-label { color: var(--err); }

/* ---------- 输入区（含模型/思考芯片） ---------- */
.inputbar { flex-shrink: 0; padding: 14px 28px 20px; }
.input-outer {
  max-width: 860px;
  margin: 0 auto;
  border: 1px solid var(--border-strong);
  border-radius: 18px;
  background: var(--bg-soft);
  display: flex;
  flex-direction: column;
  padding: 13px 13px 10px 19px;
  box-shadow: 0 6px 26px rgba(0, 0, 0, 0.3);
  transition: border-color var(--ease), box-shadow var(--ease);
}
.input-main { display: flex; align-items: flex-end; gap: 10px; }
.input-tools { display: flex; align-items: center; gap: 8px; padding-top: 11px; }
.input-tools .tools-hint { margin-left: auto; font-size: 11px; color: var(--text-faint); }
.input-tools .tools-hint kbd {
  font-family: var(--mono);
  font-size: 10px;
  border: 1px solid var(--border-strong);
  border-bottom-width: 2px;
  border-radius: 4px;
  padding: 0 4px;
  color: var(--text-dim);
  background: var(--bg);
}

/* 芯片按钮（模型 / 思考强度） */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 11px;
  border: 1px solid var(--border-strong);
  border-radius: 20px;
  background: transparent;
  color: var(--text-dim);
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
  transition: background var(--ease), color var(--ease), border-color var(--ease);
  max-width: 230px;
  white-space: nowrap;
}
.chip:hover { background: var(--bg-soft2); color: var(--text); border-color: var(--violet-border); }

/* 权限芯片：档位配色 */
.perm-chip.perm-readonly { border-color: var(--border-strong); }
.perm-chip.perm-standard { border-color: var(--cyan-border); color: #7FD8E6; }
.perm-chip.perm-full { border-color: rgba(216, 166, 87, 0.55); color: #E0B26A; }
.chip:disabled { opacity: 0.5; cursor: default; }
.chip .chip-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chip .chev { display: flex; color: var(--text-faint); }
.think-menu { position: relative; }

/* 思考强度上弹面板 */
.think-pop {
  position: absolute;
  bottom: calc(100% + 10px);
  left: 0;
  min-width: 248px;
  background: var(--bg-panel);
  border: 1px solid var(--border-strong);
  border-radius: 12px;
  box-shadow: var(--shadow-lg);
  padding: 5px;
  z-index: 70;
  animation: popUp 150ms cubic-bezier(0.2, 0.9, 0.3, 1.1);
}
@keyframes popUp { from { opacity: 0; transform: translateY(6px) scale(0.985); } to { opacity: 1; transform: none; } }
.think-pop-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border: none;
  background: transparent;
  border-radius: 8px;
  cursor: pointer;
  font-family: inherit;
  text-align: left;
  transition: background var(--ease);
}
.think-pop-item:hover { background: var(--bg-soft2); }
.think-pop-item.on { background: var(--violet-soft); }
.think-pop-item.on svg { color: var(--violet-2); }
.think-pop-item .tp-lab { font-size: 13px; color: var(--text); width: 30px; flex-shrink: 0; }
.think-pop-item.on .tp-lab { font-weight: 600; }
.think-pop-item .tp-desc { font-size: 11.5px; color: var(--text-faint); flex: 1; }
.think-pop-item svg { color: #FFFFFF; flex-shrink: 0; }

/* 模型菜单向上弹出（输入框场景） */
.model-menu.up { top: auto; bottom: calc(100% + 10px); }
.input-outer:focus-within {
  border-color: var(--violet-border);
  box-shadow: 0 6px 30px rgba(0, 0, 0, 0.35), 0 0 0 3px rgba(139, 124, 246, 0.1), 0 0 26px rgba(139, 124, 246, 0.08);
}
.input-outer textarea {
  flex: 1;
  border: none;
  outline: none;
  resize: none;
  background: transparent;
  color: var(--text);
  font-family: inherit;
  font-size: 14.5px;
  line-height: 1.6;
  max-height: 168px;
  padding: 4px 0;
}
.input-outer textarea::placeholder { color: var(--text-faint); }

.icon-btn {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background var(--ease), transform var(--ease), box-shadow var(--ease);
  flex-shrink: 0;
}
.icon-btn.send {
  background: var(--violet-grad);
  color: #FFFFFF;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 4px 16px rgba(124, 106, 240, 0.28);
}
.icon-btn.send:hover {
  transform: translateY(-1px);
  filter: brightness(1.08);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 6px 22px rgba(124, 106, 240, 0.38);
}
.icon-btn.send:active { transform: none; }
.icon-btn.send:disabled { background: #333333; color: #666666; box-shadow: none; cursor: default; transform: none; }
.icon-btn.stop {
  background: rgba(229, 72, 77, 0.12);
  color: var(--err);
  border: 1px solid rgba(229, 72, 77, 0.4);
}
.icon-btn.stop:hover { background: rgba(229, 72, 77, 0.2); }

.hint-line { max-width: 860px; margin: 8px auto 0; font-size: 11px; color: var(--text-faint); display: flex; gap: 18px; }
.hint-line kbd {
  font-family: var(--mono);
  font-size: 10px;
  border: 1px solid var(--border-strong);
  border-bottom-width: 2px;
  border-radius: 4px;
  padding: 0 4.5px;
  color: var(--text-dim);
  background: var(--bg-soft);
}

/* ---------- 浮层 ---------- */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  justify-content: flex-end;
  animation: fadeIn 160ms ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.panel {
  width: 580px;
  max-width: 92vw;
  height: 100%;
  background: var(--bg-panel);
  border-left: 1px solid var(--border);
  box-shadow: -24px 0 64px rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  animation: slideIn 220ms cubic-bezier(0.3, 0, 0.2, 1);
}
@keyframes slideIn { from { transform: translateX(34px); opacity: 0; } to { transform: none; opacity: 1; } }
.panel .p-head {
  height: 58px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 18px;
  border-bottom: 1px solid var(--border);
}
.panel .p-head .p-title { font-size: 14px; font-weight: 650; letter-spacing: 0.03em; }
.panel .p-head .spacer { flex: 1; }
.icon-btn.ghost { background: transparent; color: var(--text-dim); width: 36px; height: 36px; border-radius: 10px; }
.icon-btn.ghost:hover { background: var(--bg-soft2); color: var(--violet-2); }
.icon-btn.ghost:disabled { opacity: 0.32; cursor: default; background: transparent; }
.panel .p-body { flex: 1; overflow-y: auto; padding: 18px; background: var(--bg); }

/* ---------- 模型参数面板 ---------- */
.param-note {
  font-size: 12px;
  color: var(--text-faint);
  line-height: 1.6;
  padding: 10px 12px;
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius-sm);
  margin-bottom: 16px;
  background: rgba(139, 124, 246, 0.04);
}
.param-field {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  margin-bottom: 10px;
  background: var(--bg-soft);
  box-shadow: var(--shadow-sm);
}
.pf-top { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; }
.pf-label { font-size: 13.5px; font-weight: 600; color: var(--text); }
.pf-custom {
  font-size: 10px;
  padding: 1px 7px;
  border-radius: 20px;
  border: 1px solid var(--violet-border);
  color: var(--violet-2);
  background: var(--violet-soft);
}
.pf-val { margin-left: auto; font-family: var(--mono); font-size: 13px; color: var(--violet-2); font-weight: 600; }

/* 模型加载参数：分隔线与芯片选择 */
.param-sep {
  height: 1px;
  background: var(--border);
  margin: 18px 0 14px;
}
.choice-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 2px 0 8px; }
.choice-chip {
  font-size: 12px;
  padding: 5px 12px;
  border-radius: 20px;
  border: 1px solid var(--border-strong);
  background: var(--bg-soft2);
  color: var(--text-dim);
  cursor: pointer;
  transition: all 0.15s;
  font-family: inherit;
}
.choice-chip:hover:not(:disabled) { border-color: var(--violet-border); color: var(--text); }
.choice-chip.on {
  border-color: var(--violet-border);
  background: var(--violet-soft);
  color: var(--violet-2);
  font-weight: 600;
}
.choice-chip:disabled { opacity: 0.5; cursor: default; }
.param-loadmsg {
  margin-top: 4px;
  font-size: 12px;
  color: var(--cyan);
  text-align: right;
}

/* 专家模型下拉 */
.expert-select {
  width: 100%;
  margin: 2px 0 8px;
  padding: 7px 10px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-strong);
  background: var(--bg-soft2);
  color: var(--text);
  font-size: 12.5px;
  font-family: var(--mono);
  outline: none;
  cursor: pointer;
}
.expert-select:hover:not(:disabled) { border-color: var(--violet-border); }
.expert-select:disabled { opacity: 0.55; cursor: default; }
.expert-select option { background: var(--bg-panel); color: var(--text); }

/* 输入区图片预览 */
.img-previews {
  display: flex;
  gap: 8px;
  padding: 8px 10px 2px;
  flex-wrap: wrap;
}
.img-preview {
  position: relative;
  width: 56px;
  height: 56px;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid var(--border-strong);
}
.img-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
.img-preview .ip-del {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: none;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;
}
.img-preview .ip-del:hover { background: var(--violet); }

/* 用户气泡里的图片与识别文本 */
.bubble-imgs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }
.bubble-img {
  max-width: 180px;
  max-height: 140px;
  border-radius: 8px;
  border: 1px solid var(--border-strong);
  display: block;
}
.bubble-note {
  margin-top: 8px;
  padding-top: 7px;
  border-top: 1px dashed var(--border-strong);
  font-size: 12px;
  color: var(--text-dim);
  white-space: pre-wrap;
  line-height: 1.55;
}
.param-field input[type='range'] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 4px;
  border-radius: 3px;
  background: #3A3A3A;
  outline: none;
  margin: 4px 0 8px;
}
.param-field input[type='range']::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: var(--violet-grad);
  border: none;
  box-shadow: 0 1px 6px rgba(124, 106, 240, 0.5);
  cursor: pointer;
  transition: transform 0.15s ease;
}
.param-field input[type='range']::-webkit-slider-thumb:hover { transform: scale(1.18); }
.pf-bottom { display: flex; align-items: center; gap: 10px; font-size: 11.5px; color: var(--text-faint); }
.pf-def { font-family: var(--mono); }
.pf-reset {
  margin-left: auto;
  border: 1px solid var(--border-strong);
  background: transparent;
  color: var(--text-dim);
  font-size: 11px;
  padding: 2px 10px;
  border-radius: 20px;
  cursor: pointer;
  font-family: inherit;
  transition: border-color var(--ease), color var(--ease);
}
.pf-reset:hover { border-color: var(--violet-border); color: var(--violet-2); }

/* 模型菜单底部的参数入口 */
.mm-params {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  border-top: 1px solid var(--border);
  margin-top: 4px;
  font-size: 12.5px;
  color: var(--text-dim);
  cursor: pointer;
  transition: background var(--ease), color var(--ease);
}
.mm-params:hover { background: var(--bg-soft2); color: var(--violet-2); }

/* 云端模型分组（WorkBuddy） */
.mm-sep {
  padding: 8px 12px 4px;
  margin-top: 4px;
  border-top: 1px solid var(--border);
  font-size: 11px;
  letter-spacing: 0.4px;
  color: var(--text-faint);
}
.model-item.cloud .mi-name { font-weight: 500; }
.tag-cloud { border: 1px solid var(--violet-border); color: var(--violet-2); }
.tag-free { border: 1px solid rgba(46, 182, 125, 0.5); color: var(--ok); }
.mm-credits { float: right; color: var(--ok); font-size: 11px; }
.skill-pre {
  background: var(--term-bg);
  color: var(--term-text);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  font-family: var(--mono);
  font-size: 11.5px;
  line-height: 1.55;
  max-height: 240px;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-all;
  margin: 6px 0 10px;
}

.mem-stats { display: flex; gap: 10px; margin-bottom: 16px; }
.mem-stat {
  flex: 1;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 11px 13px;
  background: var(--bg-soft);
  box-shadow: var(--shadow-sm);
}
.mem-stat .num { font-size: 20px; font-family: var(--mono); color: var(--text); font-weight: 600; }
.mem-stat .lab { font-size: 11px; color: var(--text-faint); margin-top: 2px; letter-spacing: 0.08em; }

.mem-layer-title {
  font-size: 12px;
  color: var(--text-dim);
  letter-spacing: 0.06em;
  font-weight: 600;
  margin: 18px 0 9px;
  display: flex;
  align-items: center;
  gap: 9px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 7px;
}
.layer-clear {
  margin-left: auto;
  border: 1px solid var(--border-strong);
  background: transparent;
  color: var(--text-faint);
  font-size: 10.5px;
  padding: 2px 10px;
  border-radius: 20px;
  cursor: pointer;
  font-family: inherit;
  transition: border-color var(--ease), color var(--ease), background var(--ease);
}
.layer-clear:hover { border-color: rgba(229, 72, 77, 0.5); color: var(--err); background: rgba(229, 72, 77, 0.08); }

.mem-entry {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 10px 13px;
  margin-bottom: 8px;
  background: var(--bg-soft);
  box-shadow: var(--shadow-sm);
  transition: border-color var(--ease);
}
.mem-entry:hover { border-color: var(--border-strong); }
.mem-entry .me-title { font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 8px; }
.mem-entry .me-id { font-family: var(--mono); font-size: 11px; color: var(--text-faint); }
.mem-entry .me-body { font-size: 12.5px; color: var(--text-dim); margin-top: 6px; white-space: pre-wrap; word-break: break-word; }
.mem-entry .me-meta { font-size: 11px; color: var(--text-faint); margin-top: 7px; font-family: var(--mono); display: flex; gap: 13px; flex-wrap: wrap; }
.mem-empty { color: var(--text-faint); font-size: 12.5px; padding: 8px 2px; }

/* 阻塞加载提示 */
.blocking-toast {
  position: fixed;
  left: 50%;
  bottom: 30px;
  transform: translateX(-50%);
  background: var(--bg-panel);
  border: 1px solid var(--border-strong);
  border-radius: 22px;
  padding: 10px 20px;
  font-size: 12.5px;
  color: var(--text-dim);
  display: flex;
  align-items: center;
  gap: 11px;
  z-index: 200;
  box-shadow: var(--shadow-lg);
  animation: rise 0.25s ease;
}
.spinner {
  width: 14px;
  height: 14px;
  border: 2px solid var(--border-strong);
  border-top-color: var(--cyan);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
