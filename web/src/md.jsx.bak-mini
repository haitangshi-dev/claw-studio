// 迷你 Markdown 渲染（React 节点，无 innerHTML）
// 支持：``` 代码块、#/##/### 标题、- / 1. 列表、**粗体**、`行内代码`、[链接](url)、段落

const INLINE_RE = /(\*\*[^*\n]+\*\*|`[^`\n]+`|\[[^\]\n]+\]\([^)\n]+\))/g

function parseInline(text) {
  const parts = String(text).split(INLINE_RE)
  return parts.map((p, i) => {
    if (!p) return null
    if (p.startsWith('**') && p.endsWith('**') && p.length > 4) {
      return <strong key={i}>{p.slice(2, -2)}</strong>
    }
    if (p.startsWith('`') && p.endsWith('`') && p.length > 2) {
      return <code key={i}>{p.slice(1, -1)}</code>
    }
    const m = p.match(/^\[([^\]]+)\]\(([^)]+)\)$/)
    if (m) {
      return (
        <a key={i} href={m[2]} target="_blank" rel="noreferrer">
          {m[1]}
        </a>
      )
    }
    return p
  })
}

export function MiniMarkdown({ text }) {
  const lines = String(text || '').split('\n')
  const blocks = []
  let i = 0
  let key = 0
  let list = null // {type:'ul'|'ol', items:[]}

  const flushList = () => {
    if (list && list.items.length) {
      const Tag = list.type
      blocks.push(
        <Tag key={`l${key++}`}>
          {list.items.map((it, j) => (
            <li key={j}>{parseInline(it)}</li>
          ))}
        </Tag>
      )
    }
    list = null
  }

  while (i < lines.length) {
    const line = lines[i]

    // 代码块
    if (line.trim().startsWith('```')) {
      flushList()
      const buf = []
      i++
      while (i < lines.length && !lines[i].trim().startsWith('```')) {
        buf.push(lines[i])
        i++
      }
      i++ // 跳过结束围栏
      blocks.push(
        <pre key={`c${key++}`}>
          <code>{buf.join('\n')}</code>
        </pre>
      )
      continue
    }

    // 标题
    const h = line.match(/^(#{1,3})\s+(.+)$/)
    if (h) {
      flushList()
      const Tag = `h${h[1].length}`
      blocks.push(<Tag key={`h${key++}`}>{parseInline(h[2])}</Tag>)
      i++
      continue
    }

    // 列表
    const ul = line.match(/^\s*[-*]\s+(.*)$/)
    const ol = line.match(/^\s*\d+[.、]\s+(.*)$/)
    if (ul || ol) {
      const type = ul ? 'ul' : 'ol'
      if (!list || list.type !== type) {
        flushList()
        list = { type, items: [] }
      }
      list.items.push((ul || ol)[1])
      i++
      continue
    }

    // 空行
    if (line.trim() === '') {
      flushList()
      i++
      continue
    }

    // 段落（合并连续普通行）
    flushList()
    const para = [line]
    i++
    while (
      i < lines.length &&
      lines[i].trim() !== '' &&
      !lines[i].trim().startsWith('```') &&
      !/^(#{1,3})\s+/.test(lines[i]) &&
      !/^\s*[-*]\s+/.test(lines[i]) &&
      !/^\s*\d+[.、]\s+/.test(lines[i])
    ) {
      para.push(lines[i])
      i++
    }
    blocks.push(<p key={`p${key++}`}>{parseInline(para.join('\n'))}</p>)
  }
  flushList()

  return <div className="content-body">{blocks}</div>
}
